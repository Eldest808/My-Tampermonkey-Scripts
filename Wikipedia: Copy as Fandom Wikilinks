// ==UserScript==
// @name         Wikipedia: Copy as Fandom Wikilinks
// @namespace    http://tampermonkey.net/
// @version      1.3
// @description  Converts Wikipedia blue links to [[Wikilink]] on copy
// @author       Grok
// @match        https://*.wikipedia.org/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function() {
    'use strict';

    console.log('✅ Wikipedia Wikilink Copy script v1.3 loaded');

    function getWikiTitle(url) {
        if (!url) return null;
        try {
            const u = new URL(url.startsWith('//') ? 'https:' + url : url, window.location.origin);
            if (u.pathname.startsWith('/wiki/')) {
                let title = u.pathname.slice(6); // remove /wiki/
                title = decodeURIComponent(title.replace(/_/g, ' '));
                return title;
            }
        } catch(e) {}
        return null;
    }

    document.addEventListener('copy', function(e) {
        const sel = window.getSelection();
        if (sel.isCollapsed) return;

        // Clone the selection
        const range = sel.getRangeAt(0);
        const cloned = range.cloneContents();
        const div = document.createElement('div');
        div.appendChild(cloned);

        // Convert links
        let modified = false;
        div.querySelectorAll('a').forEach(a => {
            const title = getWikiTitle(a.href) || getWikiTitle(a.getAttribute('href'));
            if (title) {
                modified = true;
                const display = a.textContent.trim();
                const wikilink = (title === display)
                    ? `[[${title}]]`
                    : `[[${title}|${display}]]`;

                const textNode = document.createTextNode(wikilink);
                a.parentNode.replaceChild(textNode, a);
            }
        });

        if (!modified) return; // nothing to change

        const newText = div.textContent.trim();

        // Write to clipboard
        e.clipboardData.setData('text/plain', newText);
        e.preventDefault();

        console.log('📋 Converted to wikilinks:', newText.substring(0, 100) + '...');
    }, true); // Use capture phase
})();
