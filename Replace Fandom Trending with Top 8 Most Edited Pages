/* ================================================
   Replace Trending with Top 8 Most Edited Pages
   Fandom-Compatible - Bigger Thumbnails + 100 page scan
   Updated: 2026-06-22
   ================================================ */

mw.loader.using(['mediawiki.api', 'mediawiki.util']).then(function () {
    if (mw.config.get('wgCanonicalNamespace') !== 'Category') return;

    const $trendingHeader = $('.category-page__trending-pages-header');
    const $trendingModule = $('.category-page__trending-pages');

    if ($trendingModule.length === 0) return;

    $trendingHeader.hide();
    $trendingModule.hide();

    const $newSection = $('<section class="category-page__trending-pages">')
        .append('<h2 class="category-page__trending-pages-header">Top 8 Most Edited Pages</h2>')
        .append('<ul class="category-page__trending-pages-list" style="list-style:none; padding:0; margin:16px 0 0 0; display:grid; grid-template-columns: repeat(4, 1fr); gap:16px;"></ul>');

    $trendingModule.after($newSection);
    $newSection.find('ul').html('<li style="color:#aaa; grid-column: span 4; text-align:center;">Loading most edited pages...</li>');

    const api = new mw.Api();
    const catTitle = 'Category:' + mw.config.get('wgTitle');

    // Step 1: Get up to 500 category members
    api.get({
        action: 'query',
        list: 'categorymembers',
        cmtitle: catTitle,
        cmlimit: 500,
        cmtype: 'page',
        formatversion: 2
    }).then(function (data) {
        const members = (data.query && data.query.categorymembers) ? data.query.categorymembers : [];

        if (members.length === 0) {
            $newSection.find('ul').html('<li style="grid-column: span 4; text-align:center;">No pages found.</li>');
            return;
        }

        // Scan up to 100 pages — enough to find the real top 8
        // without making hundreds of API calls
        const scanLimit = Math.min(members.length, 100);
        const toScan = members.slice(0, scanLimit);
        const editCountMap = {};
        let scanned = 0;

        // Update loading message with progress
        function updateProgress() {
            $newSection.find('ul').html(
                '<li style="color:#aaa; grid-column: span 4; text-align:center;">Scanning pages... ' + scanned + ' / ' + scanLimit + '</li>'
            );
        }

        updateProgress();

        function fetchNext(index) {
            if (index >= toScan.length) {
                return renderResults();
            }

            const title = toScan[index].title;

            return api.get({
                action: 'query',
                titles: title,
                prop: 'revisions',
                rvprop: 'ids',
                rvlimit: 'max',
                formatversion: 2
            }).then(function (revData) {
                const pages = (revData.query && revData.query.pages) ? revData.query.pages : [];
                if (pages.length > 0 && !pages[0].missing) {
                    editCountMap[title] = (pages[0].revisions || []).length;
                }
                scanned++;
                updateProgress();
                return fetchNext(index + 1);
            }).catch(function () {
                editCountMap[title] = 0;
                scanned++;
                return fetchNext(index + 1);
            });
        }

        function renderResults() {
            toScan.sort(function (a, b) {
                return (editCountMap[b.title] || 0) - (editCountMap[a.title] || 0);
            });

            const top8 = toScan.slice(0, 8);
            const thumbTitles = top8.map(m => m.title).join('|');

            return api.get({
                action: 'query',
                titles: thumbTitles,
                prop: 'pageimages',
                piprop: 'thumbnail',
                pithumbsize: 400,
                formatversion: 2
            }).then(function (thumbData) {
                const thumbPages = (thumbData.query && thumbData.query.pages) ? thumbData.query.pages : [];
                const $list = $newSection.find('ul');
                $list.empty();

                top8.forEach(function (member) {
                    const tPage = thumbPages.find(p => p.title === member.title) || {};
                    const thumb = tPage.thumbnail
                        ? tPage.thumbnail.source
                        : 'https://static.wikia.nocookie.net/animated-character-database/images/7/7a/No_image_available.png';
                    const url = mw.util.getUrl(member.title);
                    const editCount = editCountMap[member.title] || 0;

                    const $item = $(`
                        <li style="text-align:center;">
                            <a href="${url}" style="text-decoration:none; color:inherit;">
                                <img src="${thumb}"
                                     style="width:100%; height:220px; object-fit:cover; border-radius:6px; box-shadow: 0 2px 6px rgba(0,0,0,0.3);"
                                     alt="${member.title}">
                                <div style="margin-top:8px; font-size:13.5px; line-height:1.35; font-weight:500;">${member.title}</div>
                                <div style="font-size:11px; color:#888; margin-top:3px;">${editCount} edits</div>
                            </a>
                        </li>
                    `);
                    $list.append($item);
                });
            });
        }

        return fetchNext(0);

    }).catch(function (err) {
        console.error('[MostEdited] Error:', err);
        $newSection.find('ul').html('<li style="color:orange; grid-column: span 4; text-align:center;">Could not load pages at this time.</li>');
    });
