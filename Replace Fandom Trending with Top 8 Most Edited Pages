/* ================================================
   Replace Trending with Top 8 Most Revised Pages
   Fandom-Compatible - Full Revision Count Fix
   Updated: 2026-06-22
   ================================================ */

mw.loader.using(['mediawiki.api', 'mediawiki.util']).then(function () {
    if (mw.config.get('wgCanonicalNamespace') !== 'Category') return;

    const $trendingHeader = $('.category-page__trending-pages-header');
    const $trendingModule = $('.category-page__trending-pages');

    if ($trendingModule.length === 0) return;

    $trendingHeader.hide();
    $trendingModule.hide();

    const $newSection = $('<section class="category-page__trending-pages">')
        .append('<h2 class="category-page__trending-pages-header">Top 8 Most Revised Pages</h2>')
        .append('<ul class="category-page__trending-pages-list" style="list-style:none; padding:0; margin:16px 0 0 0; display:grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(2, auto); gap:20px;"></ul>');

    $trendingModule.after($newSection);
    $newSection.find('ul').html('<li style="color:#aaa; grid-column: span 4; text-align:center;">Loading...</li>');

    const api = new mw.Api();
    const catTitle = 'Category:' + mw.config.get('wgTitle');

    // Step 1: Collect ALL category members via pagination
    function getAllMembers(cmcontinue, accumulated) {
        accumulated = accumulated || [];
        const params = {
            action: 'query',
            list: 'categorymembers',
            cmtitle: catTitle,
            cmlimit: 500,
            cmtype: 'page',
            formatversion: 2
        };
        if (cmcontinue) params.cmcontinue = cmcontinue;

        return api.get(params).then(function (data) {
            const batch = (data.query && data.query.categorymembers) ? data.query.categorymembers : [];
            accumulated = accumulated.concat(batch);
            if (data.continue && data.continue.cmcontinue) {
                return getAllMembers(data.continue.cmcontinue, accumulated);
            }
            return accumulated;
        });
    }

    // Step 2: Fetch TRUE revision count for a single page
    function getTrueRevisionCount(title) {
        var total = 0;

        function fetchPage(rvcontinue) {
            var params = {
                action: 'query',
                titles: title,
                prop: 'revisions',
                rvprop: 'ids',
                rvlimit: 500,
                formatversion: 2
            };
            if (rvcontinue) params.rvcontinue = rvcontinue;

            return api.get(params).then(function (revData) {
                var pages = (revData.query && revData.query.pages) ? revData.query.pages : [];
                if (pages.length > 0 && !pages[0].missing) {
                    total += (pages[0].revisions || []).length;
                }
                if (revData.continue && revData.continue.rvcontinue) {
                    return fetchPage(revData.continue.rvcontinue);
                }
                return total;
            });
        }

        return fetchPage(null).catch(function () { return 0; });
    }

    // Step 3: Scan all members, maintaining a live top 8 leaderboard
    function scanAll(members) {
        var total = members.length;
        var scanned = 0;
        var leaderboard = [];

        function updateProgress() {
            var msg = 'Scanning ' + scanned + ' / ' + total;
            if (leaderboard.length > 0) {
                msg += ' — #1: ' + leaderboard[0].title + ' (' + leaderboard[0].count + ' revisions)';
            }
            $newSection.find('ul').html(
                '<li style="color:#aaa; grid-column: span 4; text-align:center; font-size:12px;">' + msg + '</li>'
            );
        }

        function processNext(index) {
            if (index >= members.length) {
                return renderResults(leaderboard);
            }

            var title = members[index].title;

            return getTrueRevisionCount(title).then(function (count) {
                scanned++;

                if (count > 1) {
                    leaderboard.push({ title: title, count: count });
                    leaderboard.sort(function (a, b) { return b.count - a.count; });
                    if (leaderboard.length > 8) leaderboard = leaderboard.slice(0, 8);
                }

                updateProgress();
                return processNext(index + 1);
            });
        }

        return processNext(0);
    }

    // Step 4: Render the final top 8
    function renderResults(leaderboard) {
        if (leaderboard.length === 0) {
            $newSection.find('ul').html('<li style="grid-column: span 4; text-align:center;">No revised pages found.</li>');
            return;
        }

        var thumbTitles = leaderboard.map(function(e) { return e.title; }).join('|');

        return api.get({
            action: 'query',
            titles: thumbTitles,
            prop: 'pageimages',
            piprop: 'thumbnail',
            pithumbsize: 800,
            formatversion: 2
        }).then(function (thumbData) {
            var thumbPages = (thumbData.query && thumbData.query.pages) ? thumbData.query.pages : [];
            var $list = $newSection.find('ul');
            $list.empty();

            leaderboard.forEach(function (entry) {
                var tPage = thumbPages.find(function(p) { return p.title === entry.title; }) || {};
                var thumb = tPage.thumbnail
                    ? tPage.thumbnail.source
                    : 'https://static.wikia.nocookie.net/animated-character-database/images/7/7a/No_image_available.png';
                var url = mw.util.getUrl(entry.title);

                var $item = $('<li style="text-align:center;"></li>');
                $item.append(
                    $('<a></a>')
                        .attr('href', url)
                        .css({ textDecoration: 'none', color: 'inherit' })
                        .append(
                            $('<img>')
                                .attr('src', thumb)
                                .attr('alt', entry.title)
                                .css({ width: '100%', height: '400px', objectFit: 'cover', borderRadius: '6px', boxShadow: '0 2px 6px rgba(0,0,0,0.3)' })
                        )
                        .append(
                            $('<div></div>')
                                .css({ marginTop: '8px', fontSize: '15px', lineHeight: '1.35', fontWeight: '500' })
                                .text(entry.title)
                        )
                        .append(
                            $('<div></div>')
                                .css({ fontSize: '12px', color: '#888', marginTop: '3px' })
                                .text(entry.count + ' revisions')
                        )
                );
                $list.append($item);
            });
        });
    }

    // Kick it all off
    getAllMembers().then(function (members) {
        if (members.length === 0) {
            $newSection.find('ul').html('<li style="grid-column: span 4; text-align:center;">No pages found.</li>');
            return;
        }
        $newSection.find('ul').html(
            '<li style="color:#aaa; grid-column: span 4; text-align:center;">Found ' + members.length + ' pages. Starting scan...</li>'
        );
        return scanAll(members);
    }).catch(function (err) {
        console.error('[MostRevised] Error:', err);
        $newSection.find('ul').html('<li style="color:orange; grid-column: span 4; text-align:center;">Could not load pages at this time.</li>');
    });
